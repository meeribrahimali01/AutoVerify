# AutoVerify Environment Configuration Example

# Backend Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://autoverify.vercel.app

# Optional AI Key (Gemini API for student project structure analysis)
# If left empty, AutoVerify falls back to deterministic static inspection.
AUTOVERIFY_AI_API_KEY=

# Database
DATABASE_URL=sqlite:///./autoverify.db
